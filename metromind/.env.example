# Copy to .env and fill in. Never commit real secrets.
# All backend variables use the METROMIND_ prefix (see backend/app/config.py).

# --- Database ---
# Local development defaults to SQLite (backend/data/metromind.db) when unset.
# PostgreSQL (recommended for production):
# METROMIND_DATABASE_URL=postgresql+psycopg://metromind:CHANGE_ME@localhost:5432/metromind
POSTGRES_PASSWORD=CHANGE_ME

# --- Security ---
# Bearer token for admin endpoints (upload/refresh/activate/rebuild). Leave unset to disable them.
METROMIND_ADMIN_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_STRING
METROMIND_ENVIRONMENT=production
# JSON list of allowed browser origins when the frontend is hosted separately.
METROMIND_CORS_ORIGINS=["http://localhost:5173"]
METROMIND_RATE_LIMIT_PER_MINUTE=240
METROMIND_MAX_UPLOAD_MB=100

# --- Dataset source ---
# Optional direct-download URL for "Refresh from source". The official DMRC portal
# (https://otd.delhi.gov.in/data/staticDMRC/) requires a declaration form, so most
# deployments upload the ZIP instead.
# METROMIND_DATASET_SOURCE_URL=
METROMIND_DATASET_SOURCE_LABEL=Delhi Open Transit Data (DMRC static GTFS)
METROMIND_DATASET_SOURCE_ATTRIBUTION=Department of Transport, GNCTD / IIIT-Delhi - Delhi Open Transit Data, https://otd.delhi.gov.in/

# --- Routing assumptions (reported in every result that uses them) ---
METROMIND_DEFAULT_TRANSFER_PENALTY_S=300
METROMIND_DEFAULT_MIN_TRANSFER_S=120
METROMIND_MAX_ALTERNATIVES=5
METROMIND_TRACE_MAX_EVENTS=4000
METROMIND_SEARCH_TIMEOUT_S=10
# Regex (group 1 = line name) applied to route_long_name to group route variants into lines.
METROMIND_LINE_GROUP_PATTERN=^\s*([^_]+)_
METROMIND_INFER_LINE_COLORS=true
