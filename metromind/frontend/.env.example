# Frontend build-time configuration (Vite). Copy to .env.local for development.

# API origin for production builds. Leave empty when the backend serves the frontend (same origin).
VITE_API_BASE_URL=

# Dev server only: where /api is proxied during `npm run dev`.
VITE_DEV_API_PROXY=http://127.0.0.1:8000

# Map tiles (any OpenStreetMap-compatible XYZ URL). Respect the provider's usage policy.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors

# Set to true if `npm run dev` hangs on startup (sandboxed or network filesystems that block native file watching).
VITE_WATCH_POLLING=false
